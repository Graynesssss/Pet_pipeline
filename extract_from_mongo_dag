                                                                                            # Это cделано на стороне redis в параметре
                                                                                            # "decode_responses":true
            
            with MongoHook(mongo_conn_id='mongo_default').get_conn() as m_hook:
               
                event = m_hook['event']
                events = event['events']

                events = list(events.find({'timestamp': {'$gt': last_time_stamp} },{'_id': 0}))

