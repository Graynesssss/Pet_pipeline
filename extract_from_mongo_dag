    extract_raw_evets_from_mongo = extract_raw_evets_from_mongo()

    trigger_transform_task = TriggerDagRunOperator(task_id='trigger_transform_task',
                                                   trigger_dag_id='transform_data_dag',
                                                    conf = extract_raw_evets_from_mongo,
                                                    wait_for_completion = False,
                                                    )



