                r_hook.set('last_time_stamp', '1970-01-01 00:00:00')
                last_time_stamp = '1970-01-01 00:00:00'

            last_time_stamp = last_time_stamp.decode('utf8') if not isinstance(last_time_stamp,str) else last_time_stamp            
