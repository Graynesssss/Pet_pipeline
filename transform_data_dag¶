                         """,{"date_of_create_fact_sales_parquet": date_of_create_fact_sales_parquet})
        

    check = check()

    choice_extract_from_postgres_or_change_s3_file_products_or_categories = choice_extract_from_postgres_or_change_s3_file_products_or_categories()
    change_s3_file_products = change_s3_file_products("events/products.parquet")
