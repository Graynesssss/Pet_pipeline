def move():

    source_path="/opt/airflow/dags/create_table_dag.py",
    archive_dir="/opt/airflow/archive_dags/" 

    if not os.path.exists(archive_dir):
        os.makedirs(archive_dir)
        print(f"Создана папка для архива: {archive_dir}")

    # Проверяем, на месте ли исходный файл DAG
    if os.path.exists(source_path):
        filename = os.path.basename(source_path) # извлекает create_table_dag.py из source_path
        destination_path = os.path.join(archive_dir, filename)
        
        print(f"Перемещаем файл из {source_path} в {destination_path}...")
        
        # Перемещаем файл
        shutil.move(source_path, destination_path)
        print("Файл успешно перемещен. Через полминуты DAG исчезнет из UI Airflow.")
    else:
        print(f"Ошибка: Файл {source_path} не найден на этом воркере.")

def check_create_table_dag_status():

    import json

    status = json.loads( Variable.get('create_table_dag_status') )
    
    if not status:
        
        Variable.set('create_table_dag_status', 'true')

        return False
    
    return True

with DAG(
    'transform_data_dag',
    schedule=None,
    default_args=default_args,
    max_active_runs=1,
    catchup = False,
    tags=['taransform_TIRED']

) as dag:
 

    @task.branch
    def check():

        attempt = False

        status = check_create_table_dag_status()

        if not status:
            return 'trigger_create_task'

        if not attempt:
            move()

        attempt = True
        return 'skip_products_and_categories'




    trigger_create_task = TriggerDagRunOperator(task_id='trigger_create_task',
                                                trigger_dag_id='create_table_dag',
