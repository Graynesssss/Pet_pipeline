    @task.branch
    def choice_extract_from_postgres_or_change_s3_file_products_or_categories():

        import json

        click_hook = ClickHouseHook(clickhouse_conn_id='clickhouse_default')
        client = click_hook.get_conn()   
        
        s3_hook = S3Hook(aws_conn_id='s3_default')

        if not s3_hook.check_for_key(f"events/products.parquet",'fullpetpipeline') and not s3_hook.check_for_key(f"events/categories.parquet",'fullpetpipeline'):
            return 'extract_from_postgres'
        
        max_source_ts_ms_categories = json.loads( Variable.get('max_source_ts_ms_categories') )
        max_source_ts_ms_products = json.loads( Variable.get('max_source_ts_ms_products') )
        

        result_products = client.execute("""SELECT tupleElement(source,'ts_ms') as source_ts_ms
                                        FROM full_pet_pipeline.create_table_captured_changes_products_for_mat_view
                                        where tupleElement(source,'ts_ms') > %(max_source_ts_ms_products)s
                                        """,{'max_source_ts_ms_products': max_source_ts_ms_products}
                                        )

        result_categories = client.execute("""SELECT tupleElement(source,'ts_ms') as source_ts_ms                                      
                                        FROM full_pet_pipeline.create_table_captured_changes_categories_for_mat_view
                                        where tupleElement(source,'ts_ms') > %(max_source_ts_ms_categories)s
                                        """,{'max_source_ts_ms_categories': max_source_ts_ms_categories}
                                        )

        if not result_products and not result_categories:
            return 'skip_products_and_categories'

        elif result_products and result_categories:
            Variable.set('max_source_ts_ms_products',result_products[0][0])
            Variable.set('max_source_ts_ms_categories',result_categories[0][0])
            
            return ['change_s3_file_products', 'change_s3_file_categories']

        elif result_products:
            Variable.set('max_source_ts_ms_products',result_products[0][0])
            return 'change_s3_file_products'

        elif result_categories:
            Variable.set('max_source_ts_ms_categories',result_categories[0][0])
            return 'change_s3_file_categories'        
               

    @task(multiple_outputs=True)
    def extract_from_postgres():
        import os  # НЕ ЗАБУДЬТЕ ИМПОРТЫ
        import pandas as pd
        from airflow.providers.amazon.aws.hooks.s3 import S3Hook
        from airflow.providers.postgres.hooks.postgres import PostgresHook

        with PostgresHook(postgres_conn_id='postgres_default').get_conn() as p_hook:    
            cur = p_hook.cursor()
            
            cur.execute("SELECT id, name, price, category_id, updated_at FROM products") 
            products = cur.fetchall()

            cur.execute("SELECT id, name, parent_id, updated_at FROM categories") 
            categories = cur.fetchall()

        # ДЛЯ LINUX (Airflow в Docker) путей на C:\ нет! Используйте /tmp/
        local_path_products = '/tmp/products.parquet'
        local_path_categories = '/tmp/categories.parquet'

        key_path_products = "events/products.parquet"
        key_path_categories = "events/categories.parquet"
            
        dt_products = pd.DataFrame(data=products, columns=['id', 'name', 'price', 'category_id', 'updated_at'])
        dt_categories = pd.DataFrame(data=categories, columns=['id', 'name', 'parent_id', 'updated_at'])

        dt_products.to_parquet(path=local_path_products, engine='pyarrow', compression='lz4')
        dt_categories.to_parquet(path=local_path_categories, engine='pyarrow', compression='lz4')

        s3_hook = S3Hook(aws_conn_id='s3_default')

        # ИСПРАВЛЕНО: Заменили path на filename и bucket на bucket_name
        s3_hook.load_file(filename=local_path_products, key=key_path_products, bucket_name='fullpetpipeline', replace=True)
        s3_hook.load_file(filename=local_path_categories, key=key_path_categories, bucket_name='fullpetpipeline', replace=True)

        # ИСПРАВЛЕНО: У os нет метода exists. Правильно: os.path.exists
        if os.path.exists(local_path_products):
            os.remove(local_path_products)

        if os.path.exists(local_path_categories):
            os.remove(local_path_categories)

        # ИСПРАВЛЕНО: Для multiple_outputs=True нужно возвращать словарь (dict), а не tuple!
        return {
            "key_path_products": key_path_products,
            "key_path_categories": key_path_categories
        }

        
    @task
    def refresh_last_timestamp_and_product_cache(path_to_products,path_to_categories):

        context = get_current_context()

        max_ts = context['dag_run'].conf.max_ts

        local_path_products = r'/tmp/products.parquet'

        local_path_categories = r'/tmp/categories.parquet'
    
        from airflow.providers.redis.hooks.redis import RedisHook
    
        with RedisHook(redis_conn_id='redis_default').get_conn() as r_hook:

            s3_hook = S3Hook(aws_conn_id='s3_default')

            s3_hook.download_file(key=path_to_products,bucket_name='fullpetpipeline',local_path=local_path_products)
            s3_hook.download_file(key=path_to_categories,bucket_name='fullpetpipeline',local_path=local_path_categories)

            dt_products = pd.read_parquet(path=local_path_products,engine='pyarrow')

            dt_categories = pd.read_parquet(path=local_path_categories,engine='pyarrow')

            dt_dim_products = pd.merge(dt_products[['id','name','price','category_id']],dt_categories.rename(columns={'id': 'c_id'})[['c_id','name']],how='left',left_on='category_id',right_on='c_id',suffixes=('product_','category_'))

            dt_dim_products = dt_dim_products.drop(columns=['category_id','c_id'])
            
            last_time_stamp = max_ts
        
            r_hook.set('last_time_stamp',last_time_stamp)
            
            r_hook.set('product_cache',dt_dim_products.to_json(orient='records'))

            if os.path.exists(local_path_products):
                os.remove(local_path_products)
                
            if os.path.exists(local_path_categories):
                os.remove(local_path_categories)
                
            return last_time_stamp
    
    @task
    def extract_raw_events_from_clickhouse_for_transform(last_time_stamp):

        import json as js

        from airflow.providers.redis.hooks.redis import RedisHook
    
        click_hook = ClickHouseHook(clickhouse_conn_id='clickhouse_default')
        client = click_hook.get_conn()

        last_time_stamp = datetime.strptime(last_time_stamp, '%Y-%m-%d %H:%M:%S')
    
        client.execute(f"SELECT * from raw_events where timestamp > %(ts)s",{'ts': last_time_stamp})
    
        data = client.fetchall()
    
        events_dt = pd.DataFrame(data=data
                          ,columns=['event_id','user_id','session_id','event_type','product_id','timestamp','quantity','price_at_event']
                          )

        events_dt = events_dt.astype({
                    'event_id': 'int64',
                    'user_id': 'int64',
                    'session_id': 'string[pyarrow]',
                    'event_type': 'category',
                    'product_id': 'int64',
                    'timestamp': 'datetime64[ns]',  # Важно: для pandas указываем точность наносекунд [ns]
                    'quantity': 'int32',
                    'price_at_event': 'float32'
                })
    
        with RedisHook(redis_conn_id='redis_default').get_conn() as r_hook:
    
            product_jsons = r_hook.get('product_cache')
            product_dict = js.loads(product_jsons)
    
        product_dt = pd.DataFrame(data=product_dict,columns=['product_id','product_name','price','updated_at','category_name'])
        
        events_dt = events_dt.drop_duplicates()
    
        fact_sales = pd.merge(events_dt,product_dt[['product_id','product_name','category_name']],how='left',on='product_id')

        fact_sales['total'] = fact_sales['quantity'] * fact_sales['price_at_event']

        fact_sales['is_purchase'] = (fact_sales['event_type'] == 'purchase').astype('int8')

        local_path=r'/tmp/fact_sales.parquet'

        date_of_create_fact_sales_parquet = datetime.now().strftime('%Y-%m-%d')

        key_path_to_fact_sales = f"events/date={date_of_create_fact_sales_parquet}/fact_sales.parquet"          
    
        fact_sales.to_parquet(path=local_path,engine='pyarrow',compression='lz4')

        s3_hook = S3Hook(aws_conn_id='s3_default')

        s3_hook.load_file(filename=local_path,key=key_path_to_fact_sales,bucket_name='fullpetpipeline',replace=True)

        if os.path.exists(local_path):
            os.remove(local_path)
    
        return date_of_create_fact_sales_parquet

