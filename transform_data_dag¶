                                                )


    @task
    def change_s3_file_products(path_to_products):

        import json 

        local_path_products=r'/tmp/'

        key_path_products = path_to_products

        s3_hook = S3Hook(aws_conn_id='s3_default')

        s3_hook.download_file(local_path=local_path_products,key=key_path_products,bucket_name='fullpetpipeline')

        dt_products = pd.read_parquet(path=local_path_products,engine='pyarrow')
        

        click_hook = ClickHouseHook(clickhouse_conn_id='clickhouse_default')
        client = click_hook.get_conn()

        max_source_ts_ms_products = json.loads( Variable.get('max_source_ts_ms_products') )

    
        result_products = client.execute("""SELECT op
                                                ,ts_ms
                                                , ifNull(`before.id`, 0)
                                                , ifNull(`before.name`, '')
                                                , ifNull(`before.price`, 0.0)
                                                , ifNull(`before.category_id`, 0)
                                                , ifNull(`before.updated_at`, toDateTime(0))
                                                , ifNull(`after.id`, 0)
                                                , ifNull(`after.name`, '')
                                                , ifNull(`after.price`, 0)
                                                , ifNull(`after.category_id`, 0)
                                                , ifNull(`after.updated_at`, toDateTime(0))
                                            FROM full_pet_pipeline.categories
                                            where tupleElement(source,'ts_ms') > %(max_source_ts_ms_products)s"""
                                           ,{'max_source_ts_ms_products': max_source_ts_ms_products}
                                        )
                
                

        for tup in result_products:
            
            if tup[0] == 'c':

                after = tup[3:]

                dt_products = pd.concat([dt_products,after],axis=0,ignore_index=True)
                    
            elif tup[0] == 'u':
                
                product_id = tup[2]

                after = tup[5:],

                after = pd.DataFrame(after,columns=['id','name','price','category_id','updated_at'])
                
                dt_products[ dt_products['id'] == product_id ] = after             
                    
            elif tup[0] == 'd':

                product_id = tup[2]

                dt_products = dt_products[ dt_products['id'] != product_id ]

        s3_hook.load_file(filename=local_path_products,key=key_path_products,bucket_name='fullpetpipeline',replace=True)

        if os.path.exists(local_path_products):
            os.remove(local_path_products)

        

