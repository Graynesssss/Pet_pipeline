    upload_transform_data_to_clickhouse_in_fact_sales = upload_transform_data_to_clickhouse_in_fact_sales(date_of_create_fact_sales_parquet=date_of_create_fact_sales_parquet)

    check >> trigger_create_task

    trigger_create_task >> [choice_extract_from_postgres_or_change_s3_file_products_or_categories
                            ,postgres
                            ,upload_raw_events_to_clickhouse_in_raw_events]

    choice_extract_from_postgres_or_change_s3_file_products_or_categories >> [postgres
                                                                            ,change_s3_file_products
                                                                            ,change_s3_file_categories]


    postgres >> [upload_categories_to_clickhouse, upload_products_to_clickhouse]

    upload_raw_events_to_clickhouse_in_raw_events >> date_of_create_fact_sales_parquet
