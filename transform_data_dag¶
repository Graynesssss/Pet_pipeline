def on_failure_callback(context):

    dag_id = context['dag'].dag_id
    task_id = context['ti'].task_id
    error = context['exception']

    tg_hook = TelegramHook(telegram_conn_id='telegram_default')
    tg_hook.send_message(f"DAG: {dag_id}, TASK: {task_id}, ERROR: {error}")

def on_success_callback(context):

    dag_id = context['dag'].dag_id

    tg_hook = TelegramHook(telegram_conn_id='telegram_default')
    tg_hook.send_message(f"ВСЕ ПРОШЛО УСПЕШНО. ПОЗДРАВЛЯЮ!, DAG: {dag_id}")

def on_execute_callback(context):

    dag_id = context['dag'].dag_id

    tg_hook = TelegramHook(telegram_conn_id='telegram_default')
    tg_hook.send_message(f"ДАГ НАЧАЛ СВОЮ РАБОТУ!, DAG: {dag_id}")


def on_skipped_callback(context):
    
    dag_id = context['dag'].dag_id

    tg_hook = TelegramHook(telegram_conn_id='telegram_default')
    tg_hook.send_message(f"НОВЫХ СОБЫТИЙ ЗА ПОСЛЕДНИЕ 15 МИНУТ НЕ БЫЛО!, DAG: {dag_id}")
    
default_args={'on_success_callback': on_success_callback
              ,'on_failure_callback': on_failure_callback
              ,'on_execute_callback': on_execute_callback
              ,'on_skipped_callback': on_skipped_callback}

